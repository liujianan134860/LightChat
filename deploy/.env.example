# Copy to deploy/.env on the server and replace every CHANGE_ME value.
APP_ENV=production
SERVER_PORT=8080
SERVER_HTTP_PORT=8081

# Prefer an Alibaba Cloud RDS internal endpoint in the same VPC.
MYSQL_URL=jdbc:mysql://CHANGE_ME.mysql.rds.aliyuncs.com:3306/lightchat?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USER=lightchat
MYSQL_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
MOCK_PUSH_KEY=CHANGE_ME_AT_LEAST_24_RANDOM_CHARACTERS

MEDIA_STORAGE_PROVIDER=aliyun_oss
ALIYUN_OSS_ACCESS_KEY_ID=CHANGE_ME
ALIYUN_OSS_ACCESS_KEY_SECRET=CHANGE_ME
ALIYUN_OSS_BUCKET=CHANGE_ME
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou-internal.aliyuncs.com
ALIYUN_OSS_KEY_PREFIX=lightchat
ALIYUN_OSS_PUBLIC_READ=false
ALIYUN_OSS_SIGNED_URL_SECONDS=3600
